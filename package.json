{
    "name": "git-prune-branches",
    "version": "2.0.0",
    "description": "Delete local git branches that have been merged and removed on the remote repository",
    "main": "dist/index.js",
    "type": "module",
    "preferGlobal": true,
    "bin": {
        "git-prune-branches": "dist/index.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "start": "tsx ./src/index.ts",
        "test": "vitest",
        "test:once": "vitest run",
        "demo": "./src/tests/demo/run.sh",
        "lint": "tsc --noEmit && eslint . --fix && pnpm run format",
        "format": "prettier . --list-different --write",
        "check-format": "prettier . --list-different",
        "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
        "ci": "pnpm build && pnpm check-exports && pnpm test:once",
        "prepublishOnly": "pnpm run ci",
        "prepare": "husky",
        "postinstall": "node -e \"if(process.env.npm_config_global)console.log('\\n✓ You can now run: git prune-branches\\n')\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/patik/git-prune-branches.git"
    },
    "author": "Craig Patik",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/patik/git-prune-branches/issues"
    },
    "homepage": "https://github.com/patik/git-prune-branches",
    "keywords": [
        "git",
        "branch",
        "clean up",
        "prune",
        "remove",
        "delete",
        "interactive",
        "confirmation",
        "cli",
        "command",
        "tool"
    ],
    "dependencies": {
        "inquirer-grouped-checkbox": "^1.0.0",
        "minimist": "^1.2.8",
        "ora": "^9.4.1",
        "simple-stdout": "^2.2.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.1.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "prettier": "^3.9.5",
        "strip-ansi": "^7.2.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.11.0"
}
